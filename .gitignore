.DS_Store
.claude/

# La configuración principal de las conexiones está en ~/.fs-claude.json, fuera del repo.
# Se ignora cualquier connections.json heredado de versiones antiguas para no comprometer
# credenciales accidentalmente.
connections.json

# Bytecode de Python generado al ejecutar los scripts o los tests.
__pycache__/

fs-mcp/server/node_modules/
fs-mcp/server/*.tsbuildinfo
# Salida de tsc (módulos sueltos para los tests y los scripts de desarrollo).
fs-mcp/server/build/
# De dist/ solo se distribuye el bundle de esbuild, que lleva dentro las dependencias:
# el cliente no necesita Node.js tooling ni node_modules para arrancar el servidor.
fs-mcp/server/dist/*
!fs-mcp/server/dist/index.js
