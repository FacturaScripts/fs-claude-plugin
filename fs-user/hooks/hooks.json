{
  "description": "Detecta si el directorio actual pertenece a FacturaScripts e inyecta contexto de skills",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/detect-facturascripts.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\detect-facturascripts.py\" || python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\detect-facturascripts.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
