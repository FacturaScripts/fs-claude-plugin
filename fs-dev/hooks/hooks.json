{
  "description": "Detecta proyectos FacturaScripts e inyecta contexto, recuerda en cada mensaje el idioma de respuesta configurado y, tras cada edición, actualiza el copyright y ordena las clases PHP de forma secuencial en Claude Code y Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/detect-facturascripts.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\detect-facturascripts.py\" || python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\detect-facturascripts.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/language-reminder.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\language-reminder.py\" || python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\language-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/post-edit.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\post-edit.py\" || python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\post-edit.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
