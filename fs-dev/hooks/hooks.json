{
  "description": "Detecta proyectos FacturaScripts e inyecta contexto. Tras cada edición actualiza el copyright y ordena las clases PHP de forma secuencial en Claude Code y Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/detect-facturascripts.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/post-edit.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
